# Copier en .env et compléter. Ne JAMAIS committer le fichier .env.

# Déploiement Docker : nom de domaine du tableau de bord (HTTPS automatique) et mot
# de passe PostgreSQL
IBIG_DOMAIN=
POSTGRES_PASSWORD=
# HTTPS : « caddy » = Caddy intégré (serveur dédié à l'agent). Vide = un nginx déjà
# présent sur le serveur sert le HTTPS (l'installateur le configure) et joint l'agent
# sur 127.0.0.1:IBIG_LOCAL_PORT.
COMPOSE_PROFILES=caddy
IBIG_LOCAL_PORT=18000

# Base de données (SQLite pour le développement, PostgreSQL + pgvector en production)
IBIG_DATABASE_URL=sqlite:///./ibig_agent.db
# IBIG_DATABASE_URL=postgresql+psycopg://ibig:motdepasse@db:5432/ibig_agent

# Modèle d'IA (Claude, API Anthropic) — offre pro sans entraînement sur les données
ANTHROPIC_API_KEY=
# Modèle léger pour le tri des mails, modèle avancé pour la rédaction (section 16 du CDC)
IBIG_TRIAGE_MODEL=claude-haiku-4-5
IBIG_WRITING_MODEL=claude-opus-5-5

# Plafond de dépense mensuel sur l'API d'IA, en USD (alerte à 80 %)
IBIG_MONTHLY_AI_BUDGET_USD=150

# Tableau de bord : comptes nominatifs (ibig-agent utilisateur ajouter ...)
# Clé de signature des sessions : python -c "import secrets; print(secrets.token_hex(32))"
IBIG_SECRET_KEY=
IBIG_DASHBOARD_URL=http://localhost:8000
# Boîte (déclarée dans config/mailboxes.yaml) qui envoie les alertes aux valideurs
IBIG_NOTIFICATION_MAILBOX=
# Valideur des pôles sans valideur dans config/poles.yaml (ex. la direction au démarrage)
IBIG_VALIDEUR_DEFAUT=
# API de SARA (chat des solutions IBIG SOFT), 32 caractères minimum ; à utiliser
# uniquement côté serveur (voir integrations/php/sara-client.example.php)
IBIG_SARA_API_KEY=
# WhatsApp Business (API Cloud de Meta) : secret de l'application Meta et jeton de
# vérification du webhook (choisi librement : openssl rand -hex 16)
IBIG_WHATSAPP_APP_SECRET=
IBIG_WHATSAPP_VERIFY_TOKEN=
IBIG_TIMEZONE=Africa/Abidjan

# Fichiers de configuration
IBIG_CONFIG_DIR=./config
IBIG_KNOWLEDGE_DIR=./knowledge

# Les mots de passe IMAP/SMTP et jetons sont lus dans des variables d'environnement
# référencées par config/mailboxes.yaml (ex. LWS_CONTACT_PASSWORD), alimentées par le
# coffre à secrets du serveur. Jamais dans le code ni dans un tableur.
